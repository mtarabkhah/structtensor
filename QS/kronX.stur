# Kronecker (A,X)
symbols: Nr, Nc, Mr, Mc
#X(i,j) := 1 * (i = 0) * (j = 1) + 1 * (i = 1) * (j = 0)
X:U(i,j) := (i = 0) * (j = 1) + (i = 1) * (j = 0)
#X(i,j) := 1 * X:U(i,j)
X:D(i, j) := (0 <= i < 2) * (0 <= j < 2)
B(i,j) := X(i,j)
Mr() := 2
Out(i, j) := A(r, c) * B(v, w) * (0 <= r < Nr) * (0 <= c < Nc) * (0 <= v < Mr) * (0 <= w < Mc) * (i = r*Mr+v) * (j=c*Mc+w)
A:D(i, j) := (0 <= i < Nr) * (0 <= j < Nc)
B:D(i, j) := (0 <= i < Mr) * (0 <= j < Mc)
Out:D(i, j) := (0 <= i < Nr*Mr) * (0 <= j < Nc*Mc)