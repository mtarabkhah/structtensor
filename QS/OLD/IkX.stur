symbols: N

#X(i,j) := 1 * (i = 0) * (j = 1) + 1 * (i = 1) * (j = 0)
X:U(i,j) := (i = 0) * (j = 1) + (i = 1) * (j = 0)
X:D(i, j) := (0 <= i < 2) * (0 <= j < 2)
B(i, j) := X(i, j)

#I(i, j) := 1 * (0 <= i < N) * (i = j)
I:U(i, j) := (0 <= i < N) * (i = j)
I:D(i, j) := (0 <= i < N) * (0 <= j < N)
A(i,j) := I(i,j)

Out(i, j) := A(r, c) * B(v, w) * (0 <= r < N) * (0 <= c < N) * (0 <= v < 2) * (0 <= w < 2) * (i = r*2+v) * (j=c*2+w)
A:D(i, j) := (0 <= i < N) * (0 <= j < N)
B:D(i, j) := (0 <= i < 2) * (0 <= j < 2)
Out:D(i, j) := (0 <= i < N*2) * (0 <= j < N*2)